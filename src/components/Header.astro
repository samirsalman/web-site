---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const homeHref = Astro.site ? new URL(base, Astro.site).href : base;
const resumeHref = Astro.site
	? new URL('resume-samir-salman.pdf', homeHref.endsWith('/') ? homeHref : `${homeHref}/`).href
	: `${base}resume-samir-salman.pdf`;
---

<header>
	<nav>
		<h2><a href={homeHref}>{SITE_TITLE}</a></h2>
		<div class="nav-actions">
			<div class="internal-links">
				<HeaderLink href={base}>Home</HeaderLink>
				<HeaderLink href={`${base}about`}>About</HeaderLink>
			</div>
			<a class="resume-link" href={resumeHref} target="_blank" rel="noopener">Resume</a>
			<div class="social-links">
			<a href="https://x.com/samirsalman_" target="_blank">
				<span class="sr-only">Follow me on X</span>
				<svg xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision"
					text-rendering="geometricPrecision" image-rendering="optimizeQuality" fill-rule="evenodd"
					clip-rule="evenodd" viewBox="0 0 512 462.799" aria-hidden="true" width="28" height="28">
					<path fill="#fff" fill-rule="nonzero"
						d="M403.229 0h78.506L310.219 196.04 512 462.799H354.002L230.261 301.007 88.669 462.799h-78.56l183.455-209.683L0 0h161.999l111.856 147.88L403.229 0zm-27.556 415.805h43.505L138.363 44.527h-46.68l283.99 371.278z" />
				</svg>
			</a>
			<a href="https://www.linkedin.com/in/samir-salman-9bb92112a/" target="_blank">
				<span class="sr-only">Follow me on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28">
					<path fill="currentColor"
						d="M14.5 0h-13A1.5 1.5 0 0 0 0 1.5v13A1.5 1.5 0 0 0 1.5 16h13a1.5 1.5 0 0 0 1.5-1.5v-13A1.5 1.5 0 0 0 14.5 0zm-8.5 13H4V6h2v7zm-1-8.1a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2zm8.5 8.1h-2V9.5c0-.9-.7-1.5-1.5-1.5s-1.5.6-1.5 1.5V13H7V6h2v1c.4-.6 1.2-1 2-1 1.7 0 3 1.3 3 3v4z"
						</path>
				</svg>
			</a>

			<a href="https://github.com/samirsalman" target="_blank">
				<span class="sr-only">Follow me on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28">
					<path fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z">
					</path>
				</svg>
			</a>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 1.25rem 1.5rem;
		background: transparent;
		position: sticky;
		top: 0;
		z-index: 10;
		backdrop-filter: blur(12px);
		background-color: rgba(17, 18, 28, 0.55);
		width: 100%;
		box-sizing: border-box;
	}

	h2 {
		margin: 0;
		font-size: 1rem;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: white;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		justify-content: space-between;
		width: 100%;
	}

	nav a {
		color: white;
		text-decoration: none;
	}

	nav a.active {
		text-decoration: none;
		color: var(--accent);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.internal-links {
		display: flex;
		gap: 0.85rem;
	}

	.resume-link {
		padding: 0.4rem 0.9rem;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 999px;
		transition: all 0.2s ease;
		font-size: 0.9rem;
	}

	.resume-link:hover {
		border-color: rgba(255, 255, 255, 0.6);
		background: rgba(255, 255, 255, 0.1);
	}

	.social-links {
		display: flex;
		gap: 0.85rem;
	}

	.social-links a {
		display: inline-flex;
	}

	@media (max-width: 720px) {
		header {
			padding: 0.75rem 1rem;
		}

		nav {
			flex-wrap: wrap;
			justify-content: center;
			align-items: center;
			gap: 0.75rem;
		}

		h2 {
			flex: 1 1 100%;
			text-align: center;
		}

		.nav-actions {
			flex: 1 1 auto;
			justify-content: center;
			align-items: center;
			flex-wrap: wrap;
			gap: 0.75rem;
		}

		.internal-links {
			justify-content: center;
			flex-wrap: wrap;
		}

		.resume-link {
			padding: 0.35rem 0.8rem;
		}

		.social-links {
			justify-content: center;
			gap: 0.75rem;
			flex-wrap: wrap;
		}
	}
</style>